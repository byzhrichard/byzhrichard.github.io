</span></span></span><span class="line"><span class="cl"><span class="w">        </span><span class="n">generator</span><span class="p">.</span><span class="na">addProvider</span><span class="p">(</span><span class="n">event</span><span class="p">.</span><span class="na">includeServer</span><span class="p">(),</span><span class="w"> </span><span class="k">new</span><span class="w"> </span><span class="n">ModRecipeProvider</span><span class="p">(</span><span class="n">packOutput</span><span class="p">));</span><span class="w">
</span></span></span><span class="line"><span class="cl"><span class="w">        </span><span class="n">generator</span><span class="p">.</span><span class="na">addProvider</span><span class="p">(</span><span class="n">event</span><span class="p">.</span><span class="na">includeServer</span><span class="p">(),</span><span class="w"> </span><span class="k">new</span><span class="w"> </span><span class="n">LootTableProvider</span><span class="p">(</span><span class="n">packOutput</span><span class="p">,</span><span class="w"> </span><span class="n">Set</span><span class="p">.</span><span class="na">of</span><span class="p">(),</span><span class="w"> </span><span class="n">List</span><span class="p">.</span><span class="na">of</span><span class="p">(</span><span class="w">
</span></span></span><span class="line"><span class="cl"><span class="w">                </span><span class="k">new</span><span class="w"> </span><span class="n">LootTableProvider</span><span class="p">.</span><span class="na">SubProviderEntry</span><span class="p">(</span><span class="n">ModBlockLootTableProvider</span><span class="p">::</span><span class="k">new</span><span class="p">,</span><span class="w"> </span><span class="n">LootContextParamSets</span><span class="p">.</span><span class="na">BLOCK</span><span class="p">)</span><span class="w">
</span></span></span><span class="line"><span class="cl"><span class="w">        </span><span class="p">)));</span><span class="w">
</span></span></span><span class="line"><span class="cl"><span class="w">        </span><span class="n">BlockTagsProvider</span><span class="w"> </span><span class="n">blockTagsProvider</span><span class="w"> </span><span class="o">=</span><span class="w"> </span><span class="n">generator</span><span class="p">.</span><span class="na">addProvider</span><span class="p">(</span><span class="n">event</span><span class="p">.</span><span class="na">includeServer</span><span class="p">(),</span><span class="w">
