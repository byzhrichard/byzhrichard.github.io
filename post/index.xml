</span></span></span><span class="line"><span class="cl"><span class="w">        </span><span class="n">ExistingFileHelper</span><span class="w"> </span><span class="n">existingFileHelper</span><span class="w"> </span><span class="o">=</span><span class="w"> </span><span class="n">event</span><span class="p">.</span><span class="na">getExistingFileHelper</span><span class="p">();</span><span class="w">
</span></span></span><span class="line"><span class="cl"><span class="w">        </span><span class="n">CompletableFuture</span><span class="o">&lt;</span><span class="n">HolderLookup</span><span class="p">.</span><span class="na">Provider</span><span class="o">&gt;</span><span class="w"> </span><span class="n">lookupProvider</span><span class="w"> </span><span class="o">=</span><span class="w"> </span><span class="n">event</span><span class="p">.</span><span class="na">getLookupProvider</span><span class="p">();</span><span class="w">
